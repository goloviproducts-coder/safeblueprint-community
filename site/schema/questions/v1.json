{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safeblueprint.pages.dev/schema/questions/v1.json",
  "title": "SafeBlueprint question pack v1",
  "description": "A question pack as JSON. A CSV pack uses the same field names as its header row, with optional '# name:' and '# version:' lines first. Pipe-separated cells (options, risk_if, maps_to_control) may be arrays in JSON.",
  "type": "object",
  "required": ["questions"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "maxLength": 120 },
    "version": { "type": "string", "maxLength": 40 },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "pack", "section", "question", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,39}$" },
          "pack": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "section": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "order": { "type": ["string", "number"], "pattern": "^(-?[0-9]+(\\.[0-9]+)?)?$" },
          "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "help_text": { "type": "string", "maxLength": 2000 },
          "type": { "enum": ["yesno", "choice", "multi", "text", "number"] },
          "options": { "oneOf": [ { "type": "string", "description": "value=Label|value=Label" }, { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string" }, "label": { "type": "string" } } } ] } } ] },
          "required": { "type": ["string", "boolean"], "pattern": "^(true|false|yes|no|)$" },
          "weight": { "type": ["string", "number"], "minimum": 0, "maximum": 10 },
          "risk_if": { "type": ["string", "array"], "description": "Option value(s) that indicate a gap, or a comparison such as >5 for number questions." },
          "severity": { "enum": ["low", "medium", "high", ""] },
          "maps_to_control": { "type": ["string", "array"], "description": "Pipe-separated control IDs, PREFIX-ID, e.g. OWASP-LLM01|ACME-POL-07." },
          "pattern": { "type": "string", "pattern": "^(PAT-[0-9]{2,3})?$" },
          "finding_text": { "type": "string", "maxLength": 2000 },
          "action_text": { "type": "string", "maxLength": 2000 },
          "owner_role": { "type": "string", "maxLength": 2000 },
          "show_if": { "type": "string", "description": "ID=value, ID!=value, ID=a|b, joined with &." },
          "audience": { "enum": ["leaders", "delivery", "architects", ""] }
        }
      }
    }
  }
}
