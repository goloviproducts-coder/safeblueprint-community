{
  "name": "safeblueprint-community",
  "version": "1.0.2",
  "private": true,
  "description": "SafeBlueprint community edition. No runtime dependencies; tests use the built-in node:test runner.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:default-pack": "node scripts/build-default-pack.js",
    "test:security": "playwright test",
    "privacy-proof": "playwright test test/security/privacy-proof.spec.js --reporter=list",
    "threat-model": "node scripts/threat-model-generate.js",
    "threat-model:check": "node scripts/threat-model-generate.js --check",
    "threat-model:update": "node scripts/threat-model-draft.js",
    "hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fast-check": "4.10.2",
    "serve": "14.2.6"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
